{
  "name": "prostata-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Próstata Lab: entrenamiento en lectura de RM de próstata (PI-RADS v2.1) con casos PI-CAI.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43124 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.functions.json --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 43124 --strictPort",
    "pages:dev": "wrangler pages dev dist --ip 127.0.0.1 --port 43124"
  },
  "engines": { "node": ">=20.19" },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "wrangler": "^4.45.0"
  }
}
